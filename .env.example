# MindWire console — environment for docker-compose (the control plane).
#
#   cp .env.example .env   and edit. Every key maps 1:1 to apps/preview/server/env.ts (the single reader).
#   NODE_ENV, PORT and AUTH_DB_PATH are fixed by docker-compose.yml and intentionally NOT set here.
#
# The ONLY value you must change for a real deployment is AUTH_SECRET. For remote access, also set
# BASE_URL and TRUSTED_ORIGINS.

# ---- deployment mode ------------------------------------------------------------------------------------
# "self-hosted" (default): email/password sign-in, single/small-team; seeds the default daemon so a fresh
#   sign-in can chat immediately, and allows managing the host machine if ALLOW_LOCAL_RUNTIME=true.
# "cloud": the multi-tenant SaaS shape — social sign-in (when OAuth apps are set), each user starts with an
#   EMPTY fleet, and running agents on the console's own host is off by default.
CONSOLE_MODE=self-hosted

# ---- auth (Better Auth) ---------------------------------------------------------------------------------
# REQUIRED. The cookie/session signing key — MUST be >=32 chars and unique per deployment.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# ---- public URL / networking ----------------------------------------------------------------------------
# The origin the app is served from. Better Auth uses it for cookies and CSRF/origin checks, so it MUST
# match the URL users actually hit (scheme + host + port). Leave as-is only for pure localhost use.
# BASE_URL=https://console.example.com

# Extra browser origins allowed to call the auth endpoints (comma/space separated). BASE_URL is always
# trusted; add any others (e.g. a separate frontend origin) here.
# TRUSTED_ORIGINS=https://console.example.com

# Where docker-compose publishes the console. MINDWIRE_BIND_ADDR is the host interface (default 127.0.0.1;
# set 0.0.0.0 to expose on all interfaces — prefer a reverse proxy). CONSOLE_PORT is the host port.
# MINDWIRE_BIND_ADDR=127.0.0.1
# CONSOLE_PORT=8787

# ---- branding (shown on the login gate + top nav) -------------------------------------------------------
# APP_NAME=MindWire
# DOCS_URL=https://mindwire.sh/docs
# GITHUB_URL=https://github.com/oblien/mindwire

# ---- default runtime (daemon) ---------------------------------------------------------------------------
# The daemon a new session connects to when the user hasn't wired their own runtime. For a single-tenant
# self-host pointing at a daemon you run elsewhere, set these and keep SEED_DEFAULT_DAEMON on.
# DAEMON_URL=http://127.0.0.1:8790
# DAEMON_TOKEN=
# Seed a new session's fleet with DAEMON_URL. Defaults on for self-hosted, off for cloud.
# SEED_DEFAULT_DAEMON=true
# Harness selected for the session (the daemon's AGENT_TYPE).
# MINDWIRE_AGENT=claude-code

# Allow the "control this host" runtime — an embedded daemon on the machine the console runs on. OFF in
# production by default; a single-tenant self-host that wants to manage its own box sets this true. Never
# enable on a multi-tenant/public deployment.
# ALLOW_LOCAL_RUNTIME=false

# ---- Oblien (default cloud runtime) ---------------------------------------------------------------------
# Optional API base override; omit to use the oblien SDK default (api.oblien.com). Users sign in to Oblien
# from inside the console, so no server-side Oblien credential is required here.
# OBLIEN_BASE_URL=

# ---- social sign-in (cloud mode only) -------------------------------------------------------------------
# Each provider appears on the login screen only when BOTH its id and secret are set. Register the OAuth
# callback URL ${BASE_URL}/api/account/callback/{github|google} with the provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
