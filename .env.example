# SaaS Compose environment (`docker compose up --build`).

# Required: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Required in production: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# This encrypts per-user provider and runtime credentials at rest; keep it independent from AUTH_SECRET.
SECRETS_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64url-key

# SaaS database. Compose starts PostgreSQL and builds DATABASE_URL from this value.
# Any strong value is accepted; the console safely encodes it when it builds its connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-url-safe-password
# Optional database identity. These values configure the bundled Postgres container and the console.
# DATABASE_URL takes precedence when using a managed/external Postgres provider.
# POSTGRES_DB=mindwire
# POSTGRES_USER=mindwire
# DATABASE_URL=

# Public console origin. Better Auth uses it for cookies, CSRF/origin checks, and OAuth callbacks.
# For the hosted SaaS, this is normally https://console.mindwire.sh.
BASE_URL=https://console.mindwire.sh
# Additional browser origins only (comma-separated). BASE_URL is trusted automatically.
# TRUSTED_ORIGINS=https://console.mindwire.sh

# Optional encrypted computer-address directory settings. Same Console/database, key-based access.
# COMPUTER_DIRECTORY_MAX_REGISTRATIONS=100000
# COMPUTER_DIRECTORY_ENROLLMENTS_PER_DAY=100
# Trust only the actual ingress proxy IP ranges when using forwarded client IP rate limits.
# COMPUTER_DIRECTORY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Published host ports. Keep the default loopback binding behind a reverse proxy.
# MINDWIRE_BIND_ADDR=127.0.0.1
# WEB_PORT=4327
# CONSOLE_PORT=8787

# Public hosted console linked from the marketing site's "Start building" buttons.
# This is baked into the web image when it is built.
# NEXT_PUBLIC_CONSOLE_URL=https://console.mindwire.sh
# Public native app releases. Leave empty until installers/store pages are published.
# Optional override; defaults to the universal installer on the latest GitHub release.
# NEXT_PUBLIC_MAC_APP_URL=https://github.com/oblien/mindwire/releases/latest/download/Mindwire.dmg
# NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/your-published-app

# Optional Better Auth social login for the SaaS console. Register these exact callback URLs:
#   https://console.mindwire.sh/api/account/callback/github
#   https://console.mindwire.sh/api/account/callback/google
#   https://console.mindwire.sh/api/account/callback/apple
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Apple: CLIENT_ID is the Services ID configured for web sign-in, linked to the Mindwire App ID.
# CLIENT_SECRET is Apple's ES256-signed JWT generated using your Team ID, Key ID and .p8 key.
# It expires within six months; replace it before expiry and redeploy Console.
# Register console.mindwire.sh and the exact HTTPS Apple callback above in Apple Developer.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Account password-reset emails. Use a sender approved by your SMTP provider.
# Port 587 uses STARTTLS; port 465 uses TLS from the start. Encryption is required.
# Leave both SMTP_USER and SMTP_PASSWORD empty only for a trusted relay without authentication.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Mindwire <accounts@mindwire.sh>

# Optional mobile push delivery (Mindwire Console owns the registry and sender).
# Keep credentials outside Git and build contexts. Use a server-side secret below,
# or mount a read-only file with docker/docker-compose.push.yml in Compose.
# Server-side secret: the complete Firebase service-account JSON (never a VITE_ variable).
# FCM_SERVICE_ACCOUNT_JSON=
# Alternatively mount a read-only file. JSON takes precedence when both are set.
# FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# MINDWIRE_FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json
# Native and browser apps use Mindwire accounts. Older native versions retain
# verified previous-account access during migration. Override only for a trusted provider.
# PUSH_IDENTITY_PROVIDER_URL=https://api.oblien.com

# Mindwire Cloud Computers. Server-only reseller credentials for an Enterprise
# provider account; never put these in NEXT_PUBLIC_* or native app settings.
# Existing self-hosted/personal computers need none of these variables.
# OBLIEN_CLIENT_ID=
# OBLIEN_CLIENT_SECRET=
# OBLIEN_BASE_URL=https://api.oblien.com
# OBLIEN_WEBHOOK_SECRET=
# The provider must allow BASE_URL's host in its own REDIRECT_ALLOWED_HOSTS
# (for example console.mindwire.sh) for checkout and billing-portal returns.
# This is configured on Oblien, not by adding that variable to Console.
# Native runtime endpoint: https://workspace.oblien.com (the Oblien SDK default).
# Console supplies the owned computer's runtime token; native runtime HTTP,
# streams and WebSockets connect directly to Oblien. No custom runtime hostname is needed.
