# SaaS Compose environment (`docker compose up --build`).
# For the private console + daemon stack, use packages/docker/.env.example instead.

# Required: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# SaaS database. Compose starts PostgreSQL and builds DATABASE_URL from this value.
# Use a URL-safe random value (or percent-encode it) because it becomes part of a connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-url-safe-password

# Public console origin. Better Auth uses it for cookies, CSRF/origin checks, and OAuth callbacks.
# For the hosted SaaS, this is normally https://console.mindwire.sh.
BASE_URL=https://console.mindwire.sh
# Additional browser origins only (comma-separated). BASE_URL is trusted automatically.
# TRUSTED_ORIGINS=https://console.mindwire.sh

# Published host ports. Keep the default loopback binding behind a reverse proxy.
# MINDWIRE_BIND_ADDR=127.0.0.1
# WEB_PORT=4327
# CONSOLE_PORT=8787

# Public hosted console linked from the marketing site's "Start building" buttons.
# This is baked into the web image when it is built.
# NEXT_PUBLIC_CONSOLE_URL=https://console.mindwire.sh

# Optional Better Auth social login for the SaaS console. Register these exact callback URLs:
#   https://console.mindwire.sh/api/account/callback/github
#   https://console.mindwire.sh/api/account/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
