# SaaS Compose environment (`docker compose up --build`).
# For the private console + daemon stack, use packages/docker/.env.example instead.

# Required: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Public console origin (required outside localhost).
# BASE_URL=https://console.example.com
# TRUSTED_ORIGINS=https://console.example.com

# Published host ports. Keep the default loopback binding behind a reverse proxy.
# MINDWIRE_BIND_ADDR=127.0.0.1
# WEB_PORT=4327
# CONSOLE_PORT=8787

# Public hosted console linked from the marketing site's "Start building" buttons.
# This is baked into the web image when it is built.
# NEXT_PUBLIC_CONSOLE_URL=https://console.mindwire.sh

# Optional social login for the SaaS console.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
