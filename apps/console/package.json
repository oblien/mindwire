{
  "name": "@mindwire/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hostable Mindwire console — a Vite SPA and Hono server for managing runtimes and driving coding agents.",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsup",
    "start": "node dist-server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.0",
    "lucide-react": "^1.30.0",
    "mindwire": "workspace:*",
    "oblien": "^2.2.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0"
  },
  "optionalDependencies": {
    "dockerode": "^5.0.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
