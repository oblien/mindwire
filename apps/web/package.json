{
  "name": "@mindwire/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "gen:reference": "bun scripts/gen-openapi-docs.mjs && bun --filter=mindwire run docs:api && bun scripts/gen-go-docs.mjs && bun scripts/gen-catalog-docs.mjs",
    "dev": "fumadocs-mdx && next dev",
    "build": "bun run gen:reference && fumadocs-mdx && next build",
    "serve": "next start -p 4327",
    "check": "tsc --noEmit",
    "gen:social": "bun scripts/gen-social-image.tsx"
  },
  "dependencies": {
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-openapi": "^12.4.2",
    "fumadocs-ui": "^16.17.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
