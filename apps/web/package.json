{
  "name": "@mindwire/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "gen:reference": "bun scripts/gen-openapi-docs.mjs && bun --filter=mindwire run docs:api && bun scripts/gen-go-docs.mjs && bun scripts/gen-catalog-docs.mjs",
    "dev": "fumadocs-mdx && next dev",
    "build": "bun run gen:reference && fumadocs-mdx && next build",
    "serve": "next start -p 4327",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "^16.14.2",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-openapi": "^11.2.3",
    "fumadocs-ui": "^16.14.2",
    "geist": "^1.3.1",
    "lucide-react": "^1.25.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
