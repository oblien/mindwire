# Required for the self-hosted console. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Required in production: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Separate from AUTH_SECRET; encrypts all Console-managed provider/runtime credentials at rest.
SECRETS_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64url-key

# Required self-host Console administrator. This deployment has one account; signup is disabled.
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=change-me-to-a-long-random-password

# Required runtime bearer token. Generate with: openssl rand -hex 32
MINDWIRE_RUNTIME_TOKEN=change-me-to-a-separate-random-runtime-token

# Pin the console and runtime to one tested MindWire release (for example, 0.1.1).
MINDWIRE_VERSION=0.1.1

# Public console URL when using a reverse proxy.
# BASE_URL=https://console.example.com
# TRUSTED_ORIGINS=https://console.example.com

# MINDWIRE_BIND_ADDR=127.0.0.1
# CONSOLE_PORT=8787
# MINDWIRE_AGENT=claude-code
