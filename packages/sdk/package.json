{
  "name": "mindwire",
  "version": "0.1.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsup": "8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "oblien": ">=2.2.0",
    "dockerode": ">=4.0.0",
    "ssh2": ">=1.15.0"
  },
  "peerDependenciesMeta": {
    "oblien": {
      "optional": true
    },
    "dockerode": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "description": "TypeScript SDK for the mindwire daemon — one client for every coding-agent harness (Claude Code, Codex, Copilot CLI, opencode).",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mindwire",
    "coding-agent",
    "claude-code",
    "codex",
    "copilot",
    "opencode",
    "agent",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oblien/mindwire.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://mindwire.sh",
  "bugs": "https://github.com/oblien/mindwire/issues",
  "scripts": {
    "prepack": "bun run build",
    "build": "tsup && tsc --emitDeclarationOnly",
    "docs:api": "node scripts/gen-sdk-docs.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "RUN_E2E=1 RUN_DOCKER_E2E=1 bun test test/e2e",
    "clean": "rm -rf dist"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
