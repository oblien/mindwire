{
  "name": "mindwire",
  "version": "0.1.59",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "bin": {
    "mindwire": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "dockerode": "^5.0.1"
  },
  "peerDependencies": {
    "dockerode": ">=4.0.0",
    "ssh2": ">=1.15.0"
  },
  "peerDependenciesMeta": {
    "dockerode": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "description": "White-label and customize leading agent harnesses to power your product, without rebuilding the agent layer.",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mindwire",
    "coding-agent",
    "claude-code",
    "codex",
    "grok",
    "copilot",
    "opencode",
    "agent",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oblien/mindwire.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://mindwire.sh",
  "bugs": "https://github.com/oblien/mindwire/issues",
  "scripts": {
    "prepack": "bun run build",
    "build": "tsup && tsc --emitDeclarationOnly",
    "docs:api": "node scripts/gen-sdk-docs.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun run build && RUN_E2E=1 RUN_DOCKER_E2E=1 bun test test/e2e",
    "clean": "rm -rf dist"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "oblien": "^2.10.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@ngrok/ngrok": "^1.7.0"
  }
}
