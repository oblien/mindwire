{
  "version": "0.154.0",
  "source": "codex app-server generate-json-schema",
  "items": [
    {
      "wire": {
        "id": "user",
        "type": "userMessage",
        "content": [
          {
            "type": "text",
            "text": "Inspect the project."
          }
        ]
      },
      "want": {
        "disposition": "input"
      }
    },
    {
      "wire": {
        "id": "hook",
        "type": "hookPrompt",
        "fragments": [
          {
            "hookRunId": "hook-run",
            "text": "Project context"
          }
        ]
      },
      "want": {
        "disposition": "input"
      }
    },
    {
      "wire": {
        "id": "answer",
        "type": "agentMessage",
        "text": "The project is ready.",
        "phase": "final_answer"
      },
      "want": {
        "event": "text",
        "text": "The project is ready."
      }
    },
    {
      "wire": {
        "id": "output",
        "type": "functionCallOutput",
        "name": "lookup",
        "namespace": "functions",
        "output": [
          {
            "type": "input_text",
            "text": "Tool replied"
          },
          {
            "type": "input_image",
            "image_url": "data:image/png;base64,OPAQUE_IMAGE"
          },
          {
            "type": "input_audio",
            "audio_url": "data:audio/wav;base64,OPAQUE_AUDIO"
          },
          {
            "type": "encrypted_content",
            "encrypted_content": "OPAQUE_ENCRYPTED"
          }
        ]
      },
      "want": {
        "event": "tool_result",
        "tool": "lookup",
        "output": "Tool replied\nImage\nAudio\nEncrypted tool content"
      }
    },
    {
      "wire": {
        "id": "plan",
        "type": "plan",
        "text": "Inspect the code, then run the relevant tests."
      },
      "want": {
        "event": "interaction",
        "kind": "plan",
        "detail": "Inspect the code, then run the relevant tests."
      }
    },
    {
      "wire": {
        "id": "reason",
        "type": "reasoning",
        "summary": [
          "Checking the parser.",
          "Checking failure paths."
        ],
        "content": [
          "Model-provided reasoning text"
        ]
      },
      "want": {
        "event": "thinking",
        "text": "Checking the parser.\n\nChecking failure paths."
      }
    },
    {
      "wire": {
        "id": "command",
        "type": "commandExecution",
        "command": "go test ./...",
        "commandActions": [],
        "cwd": "/repo",
        "status": "completed",
        "aggregatedOutput": "ok",
        "exitCode": 0,
        "durationMs": 12
      },
      "want": {
        "event": "tool_result",
        "tool": "shell",
        "output": "ok",
        "action": "shell"
      }
    },
    {
      "wire": {
        "id": "patch",
        "type": "fileChange",
        "status": "completed",
        "changes": [
          {
            "path": "old.go",
            "kind": {
              "type": "update",
              "move_path": "new.go"
            },
            "diff": "@@ -1 +1 @@\n-old\n+new"
          },
          {
            "path": "added.go",
            "kind": {
              "type": "add"
            },
            "diff": "@@ -0,0 +1 @@\n+package main"
          },
          {
            "path": "deleted.go",
            "kind": {
              "type": "delete"
            },
            "diff": "@@ -1 +0,0 @@\n-package old"
          }
        ]
      },
      "want": {
        "event": "tool_result",
        "tool": "apply_patch",
        "outputContains": "update old.go",
        "action": "file_edit",
        "paths": [
          "new.go",
          "added.go",
          "deleted.go"
        ]
      }
    },
    {
      "wire": {
        "id": "mcp",
        "type": "mcpToolCall",
        "server": "docs",
        "tool": "search",
        "arguments": {
          "query": "Codex"
        },
        "status": "completed",
        "result": {
          "content": [
            {
              "type": "text",
              "text": "Found documentation"
            }
          ],
          "structuredContent": {
            "count": 1
          }
        }
      },
      "want": {
        "event": "tool_result",
        "tool": "docs.search",
        "outputContains": "Found documentation",
        "action": "mcp"
      }
    },
    {
      "wire": {
        "id": "dynamic",
        "type": "dynamicToolCall",
        "tool": "client.lookup",
        "namespace": "functions",
        "arguments": {
          "key": "version"
        },
        "status": "completed",
        "success": true,
        "contentItems": [
          {
            "type": "inputText",
            "text": "Current version"
          },
          {
            "type": "inputImage",
            "imageUrl": "data:image/png;base64,OPAQUE_IMAGE"
          },
          {
            "type": "inputAudio",
            "audioUrl": "data:audio/wav;base64,OPAQUE_AUDIO"
          }
        ]
      },
      "want": {
        "event": "tool_result",
        "tool": "client.lookup",
        "output": "Current version\nImage\nAudio",
        "action": "mcp"
      }
    },
    {
      "wire": {
        "id": "collab",
        "type": "collabAgentToolCall",
        "tool": "spawnAgent",
        "status": "completed",
        "senderThreadId": "thread-1",
        "receiverThreadIds": [
          "child"
        ],
        "agentsStates": {
          "child": {
            "status": "completed",
            "message": "Checked the files."
          }
        },
        "prompt": "Check the files."
      },
      "want": {
        "event": "tool_result",
        "tool": "spawnAgent",
        "output": "child: completed\nChecked the files.",
        "action": "other"
      }
    },
    {
      "wire": {
        "id": "subagent",
        "type": "subAgentActivity",
        "agentPath": "/root/reviewer",
        "agentThreadId": "child",
        "kind": "completed"
      },
      "want": {
        "event": "interaction",
        "kind": "info",
        "title": "Agent finished",
        "detail": "/root/reviewer"
      }
    },
    {
      "wire": {
        "id": "web",
        "type": "webSearch",
        "query": "Codex app-server protocol",
        "action": {
          "type": "search",
          "query": "Codex app-server protocol"
        },
        "results": [
          {
            "url": "https://learn.chatgpt.com/docs/app-server",
            "title": "App server"
          }
        ]
      },
      "want": {
        "event": "tool_result",
        "tool": "web_search",
        "outputContains": "https://learn.chatgpt.com/docs/app-server",
        "action": "web_search"
      }
    },
    {
      "wire": {
        "id": "image",
        "type": "imageView",
        "path": "/repo/preview.png"
      },
      "want": {
        "event": "tool_result",
        "tool": "view_image",
        "output": "/repo/preview.png",
        "action": "file_read"
      }
    },
    {
      "wire": {
        "id": "sleep",
        "type": "sleep",
        "durationMs": 1250
      },
      "want": {
        "event": "interaction",
        "kind": "info",
        "title": "Wait finished",
        "detail": "1.25 seconds"
      }
    },
    {
      "wire": {
        "id": "generated",
        "type": "imageGeneration",
        "result": "OPAQUE_IMAGE",
        "status": "completed",
        "savedPath": "/tmp/diagram.png"
      },
      "want": {
        "event": "tool_result",
        "tool": "image_generation",
        "output": "/tmp/diagram.png"
      }
    },
    {
      "wire": {
        "id": "review-in",
        "type": "enteredReviewMode",
        "review": "Reviewing the latest change."
      },
      "want": {
        "event": "interaction",
        "kind": "info",
        "title": "Review started",
        "detail": "Reviewing the latest change."
      }
    },
    {
      "wire": {
        "id": "review-out",
        "type": "exitedReviewMode",
        "review": "No issues found."
      },
      "want": {
        "event": "interaction",
        "kind": "info",
        "title": "Review complete",
        "detail": "No issues found."
      }
    },
    {
      "wire": {
        "id": "compact",
        "type": "contextCompaction"
      },
      "want": {
        "event": "compaction"
      }
    }
  ],
